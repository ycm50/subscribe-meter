<?xml version="1.0" encoding="utf-8"?>
<!-- 密钥存放在 Android Keystore 加密的私有文件中:禁止云备份与设备迁移带走密文 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secure/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secure/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
